# Public source allowlist: recordings, local notes and downloaded tools stay local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/package.json
!/package-lock.json
!/app/
!/desktop/
!/native/
!/tests/
!/scripts/
!/docs/

# Dependencies, caches, build products and local developer tools
node_modules/
tools/
dist/
build/
native/bin/
native/speech/*
!native/speech/*LICENSE.txt
!native/speech/README.md
.cache/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.dmp
*.obj
*.o
*.a
*.lib
*.pdb
*.exe
*.dll
*.dylib
*.so
*.bin
*.zip
*.7z
*.dmg
*.pkg

# Credentials, private configuration, certificates and real databases
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.netrc
credentials.json
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.p7b
*.mobileprovision
*.provisionprofile
*.jks
*.keystore
id_rsa*
id_ed25519*
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.mdb
*.accdb
*.sql
*.dump
secrets.*
**/.aws/
**/.ssh/

# User projects, audio libraries and recordings; retain only the built-in click
*.rpp
*.rpp-bak
*.zlplay
*.zlset
*.zlplaylibrary
*.wav
*.mp3
*.flac
*.ogg
*.aif
*.aiff
*.m4a
*.aac
!app/Meuclick.wav
app/pads/
app/LEIA-ME.txt
**/profiles/
**/*-profile/

# macOS builds keep Intel and Apple Silicon resources separate.
/native/bin-*/
/native/speech-*/
/native/build-*/

# Private local continuity notes never ship.
/local-notes/
