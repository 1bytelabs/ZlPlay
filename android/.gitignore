# Android development

# Private device metadata, local SDK paths, debug signing keys and build outputs are not source files.
.gradle/
.idea/
local.properties
*.jks
*.keystore
captures/

# Android native build intermediates contain local SDK/compiler paths.
.cxx/
.externalNativeBuild/

# Signing keys and private local signing configuration
*.p12
*.pfx
keystore.properties
signing.properties

# APKs belong to release assets, never to the source tree
*.apk
*.aab
*.apks
*.idsig
